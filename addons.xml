<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.xtreamcodes"
       name="Xtream Codes IPTV"
       version="1.12.1"
       provider-name="custom">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Xtream Codes API client: live TV, EPG, catch-up, movies and series</summary>
    <description lang="en_GB">Browse channel groups and channels from an Xtream Codes compatible server, with now/next from a full XMLTV guide downloaded in the background, catch-up (timeshift) for channels with TV archive, movies (VOD) and series. The User-Agent is configurable and defaults to TiviMate's.</description>
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
<addon id="repository.chisht"
       name="chisht Repository"
       version="1.0.0"
       provider-name="chisht">
  <extension point="xbmc.addon.repository" name="chisht Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/chisht/plugin.video.xtreamcodes/kodi-repo/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/chisht/plugin.video.xtreamcodes/kodi-repo/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/chisht/plugin.video.xtreamcodes/kodi-repo/zips/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Updates for the Xtream Codes IPTV add-on</summary>
    <description lang="en_GB">Install this repository to get the Xtream Codes IPTV add-on and receive its updates automatically.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
</addons>
