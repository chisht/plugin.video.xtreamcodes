<?xml version="1.0" encoding="UTF-8"?>
<!-- Grid TV guide, STBEmu (Stalker portal) look: dark, orange headings and
     orange programme blocks on now. Programme buttons are made by guide.py,
     which also sets their colours from the theme. -->
<window>
  <defaultcontrol>9000</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="FF000000">white.png</texture>
    </control>
    <control type="button" id="9000">
      <left>-200</left><top>-200</top><width>10</width><height>10</height>
    </control>

    <!-- header bar -->
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>100</height>
      <texture colordiffuse="FF141414">white.png</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>4</height>
      <texture colordiffuse="FFE08A1E">white.png</texture>
    </control>
    <control type="label">
      <left>40</left><top>18</top><width>1200</width><height>44</height>
      <font>font13</font><textcolor>FFE08A1E</textcolor>
      <label>$INFO[Window.Property(header)]</label>
    </control>
    <control type="label">
      <left>40</left><top>60</top><width>1860</width><height>34</height>
      <font>font10</font><textcolor>FF9A9A9A</textcolor>
      <label>OK: watch here (OK again: fullscreen)   Left/Right: time   Up/Down: channels   CH+/CH-: page   Back: close</label>
    </control>
    <control type="label">
      <left>1500</left><top>18</top><width>380</width><height>44</height>
      <font>font13</font><textcolor>FFFFFFFF</textcolor><align>right</align>
      <label>$INFO[System.Time]</label>
    </control>

    <!-- time columns -->
    <control type="image">
      <left>360</left><top>150</top><width>1530</width><height>36</height>
      <texture colordiffuse="FF0A0A0A">white.png</texture>
    </control>
    <control type="label">
      <left>40</left><top>150</top><width>300</width><height>36</height>
      <font>font12</font><textcolor>FFE08A1E</textcolor><aligny>center</aligny>
      <label>$INFO[Window.Property(day)]</label>
